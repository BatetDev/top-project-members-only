<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Members Only</title>
  </head>
  <body class="bg-gray-900 text-emerald-300 p-2">
    <h1 class="text-3xl font-bold">Members Only</h1>
    <% if (locals.currentUser) { %>
      <p>Welcome back, <%= currentUser.username %>! You are logged in.</p>
      <form action="/log-out" method="POST" class="mt-4">
        <button class="btn bg-red-600 hover:bg-red-700 text-white" type="submit">Log Out</button>
      </form>
    <% } else { %>
    <p>Welcome, guest! Please <a href="/log-in">log in</a>.</p>
    <% } %>
  </body>
</html>
