<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Members Only - Join the Club</title>
  </head>
  <body class="bg-gray-900 text-emerald-300 p-2">
    <h1 class="text-3xl font-bold">Join the club</h1>
    <p class="mb-4">Enter the secret passcode to become a member.</p>

    <% if (locals.errors) { %>
      <ul class="text-red-500 mb-4">
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <form class="bg-gray-800 p-1.5" method="POST" action="/club/join">
      <label for="passcode">Passcode</label>
      <input
        class="input"
        id="passcode"
        name="passcode"
        type="password"
        placeholder="Secret passcode"
        autocomplete="off"
        required
      />
      <button class="btn" type="submit">Join the club</button>
    </form>
  </body>
</html>