<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title>Members Only - New Message</title>
  </head>
  <body class="bg-gray-900 text-emerald-300 p-2">
    <h1 class="text-3xl font-bold">New message</h1>

    <% if (locals.errors) { %>
      <ul class="text-red-500 mb-4">
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <form class="bg-gray-800 p-1.5" method="POST" action="/messages">
      <label for="title">Title</label>
      <input
        class="input"
        id="title"
        name="title"
        type="text"
        placeholder="Give your message a title"
        maxlength="100"
        required
      />

      <label for="body">Message</label>
      <textarea
        class="input"
        id="body"
        name="body"
        rows="6"
        placeholder="Write your message here..."
        required
      ></textarea>

      <button class="btn" type="submit">Post message</button>
    </form>
  </body>
</html>